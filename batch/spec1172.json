{
  "_comment": "v1.16.12 - Bellum Iugurthinum 85.29-37 (the second Marius excerpt), 86, 91, 93, 95-96. Sections from tools/xml_sections.js; 95-96 spans two chapters (sectionFiles).",
  "iug.85b": ["sall.2", "Non possum fidei causa imagines", "quasi debitos a vobis repetit."],
