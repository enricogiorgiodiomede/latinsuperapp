{
  "iug.41": ["sall.2", "Ceterum mos partium et factionum", "quasi permixtio terrae oriri coepit."],
  "iug.42": ["sall.2", "Nam postquam Ti. et C. Gracchus", "Quam ob rem ad inceptum redeo."],
  "iug.44": ["sall.2", "Sed ubi in Africam venit", "cuncta fuere et alia amplius."],
  "iug.51": ["sall.2", "Ceterum facies totius negoti", "eminus pugnando retinere."],
  "iug.63": ["sall.2", "Per idem tempus Uticae forte", "quasi pollutus haberetur."]
}
